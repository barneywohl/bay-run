{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.barneywohl/bay-run",
  "title": "Bay Run",
  "description": "Free-at-launch OpenAI-compatible inference with signed provenance receipts and three focused MCP tools.",
  "version": "1.2.0",
  "websiteUrl": "https://run.huggingbay.xyz",
  "repository": {
    "url": "https://github.com/barneywohl/bay-run",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://run.huggingbay.xyz/mcp/",
      "headers": [
        {
          "name": "Authorization",
          "description": "Mint the bounded launch bearer using the form-encoded client_credentials request shown at https://run.huggingbay.xyz/quickstart, then send Authorization: Bearer <token>.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": ["get_task_quote", "run_task", "verify_result"],
      "openai_compatible_base_url": "https://run.huggingbay.xyz/v1",
      "server_card_url": "https://run.huggingbay.xyz/.well-known/mcp/server-card.json",
      "llms_txt_url": "https://run.huggingbay.xyz/llms.txt",
      "oauth_protected_resource_url": "https://run.huggingbay.xyz/.well-known/oauth-protected-resource",
      "oauth_token_url": "https://run.huggingbay.xyz/oauth/token",
      "quickstart_url": "https://run.huggingbay.xyz/quickstart",
      "categories": ["ai-and-machine-learning", "developer-tools", "agents"],
      "keywords": ["mcp", "llm-router", "small-models", "inference", "agents", "openai-compatible", "provenance"]
    }
  }
}
