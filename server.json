{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.barneywohl/bay-run",
  "title": "Bay Run",
  "description": "Guard-first specialist Pin routing and execution over a 3-tool MCP front door.",
  "version": "2.0.0",
  "websiteUrl": "https://run.huggingbay.xyz",
  "repository": {
    "url": "https://github.com/barneywohl/bay-run",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://run.huggingbay.xyz/mcp/",
      "headers": [
        {
          "name": "Authorization",
          "description": "Mint a resource-bound demo bearer using the JSON request shown at https://run.huggingbay.xyz/quickstart with resource=https://run.huggingbay.xyz/mcp/, then send Authorization: Bearer <token>. On 401, follow the MCP protected-resource metadata and retry the unchanged request once.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "coprocessor",
        "run_pin",
        "solve_task"
      ],
      "openai_compatible_base_url": "https://run.huggingbay.xyz/v1",
      "server_card_url": "https://run.huggingbay.xyz/.well-known/mcp/server-card.json",
      "llms_txt_url": "https://run.huggingbay.xyz/llms.txt",
      "oauth_protected_resource_url": "https://run.huggingbay.xyz/.well-known/oauth-protected-resource",
      "oauth_token_url": "https://run.huggingbay.xyz/oauth/token",
      "quickstart_url": "https://run.huggingbay.xyz/quickstart",
      "categories": [
        "ai-and-machine-learning",
        "developer-tools",
        "agents"
      ],
      "keywords": [
        "mcp",
        "llm-router",
        "small-models",
        "inference",
        "agents",
        "openai-compatible",
        "provenance"
      ]
    }
  }
}
